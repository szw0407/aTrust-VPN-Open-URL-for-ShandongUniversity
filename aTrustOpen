#! /usr/bin/python3

import sys
import webbrowser
import re
import os
import argparse

def pre_process_url(url: str) -> (str, bool):
    if url.startswith("http://"):
        return url[7:], False
    if url.startswith("https://"):
        return url[8:], True
    # check other protocols
    if re.match(r"^[a-zA-Z]+://", url):
        raise ValueError("Unsupported protocol")
    # Warning: use http by default. 
    sys.stderr.write("Warning: use http by default\n")
    return url, False

def modify_url(url: str, https: bool = False) -> str:
    k = url.find("/")
    if k > 0:
        left = url[:k]
        right = url[k:]
    else:
        left = url
        right = ""
    left = left.replace('.', '-')
    if https:
        left = f"https://{left}-s"
    else:
        left = f"https://{left}"
    left += ".atrust.sdu.edu.cn:81"
    return left + right

def main():
    parser = argparse.ArgumentParser(
        description="Open aTrust VPN URL for Shandong University in the browser.",
        usage="""%(prog)s [options] <URL>

Example:
    %(prog)s https://www.sdu.edu.cn

Options:
    -h, --help    Display this help message and exit
    -v, --version Display the version of the script and exit
    -r, --raw     Just return the modified URL to the standard output
    -b, --browser Use the given browser or program to open the URL
    --login       Open the URL to login to the aTrust VPN on web

More examples:
    %(prog)s -b /usr/bin/firefox https://www.sdu.edu.cn
    %(prog)s -b w3m https://www.sdu.edu.cn
    %(prog)s -b "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe" --no-sandbox https://www.sdu.edu.cn
"""
    )
    parser.add_argument("url", nargs="?", help="The URL to open")
    parser.add_argument("-v", "--version", action="store_true", help="Show version and exit")
    parser.add_argument("-r", "--raw", action="store_true", help="Just output the modified URL")
    parser.add_argument("-b", "--browser", nargs="+", help="Browser/program to use to open the URL")
    parser.add_argument("--login", action="store_true", help="Open login page for aTrust VPN")

    args = parser.parse_args()

    if args.version:
        print("aTrust URL Opener v1.0")
        sys.exit(0)

    if args.login:
        webbrowser.open("https://vpn.sdu.edu.cn")
        sys.exit(0)

    if args.url is None and not args.browser:
        parser.print_usage()
        sys.stderr.write("Error: Invalid number of arguments\n")
        print("For more information, use: %s --help" % sys.argv[0])
        sys.exit(1)

    if args.raw:
        if not args.url:
            sys.stderr.write("Error: No URL provided for --raw\n")
            sys.exit(1)
        url, https = pre_process_url(args.url)
        print(modify_url(url, https))
        sys.exit(0)

    if args.browser:
        if not args.url:
            sys.stderr.write("Error: No URL provided for --browser\n")
            sys.exit(1)
        browser_with_args = args.browser
        path = browser_with_args[0]
        if " " in path:
            browser_with_args[0] = "\"" + path + "\""
        url, https = pre_process_url(args.url)
        os.system(" ".join(browser_with_args) + " " + modify_url(url, https))
        sys.exit(0)

    if args.url:
        url, https = pre_process_url(args.url)
        print(modify_url(url, https))
        webbrowser.open(modify_url(url, https))
        sys.exit(0)

    parser.print_help()

if __name__ == "__main__":
    main()
